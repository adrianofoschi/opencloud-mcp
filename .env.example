# Copy to .env and fill in. Never commit .env.
OPENCLOUD_URL=http://opencloud:9200
# Only when OpenCloud is reached by a name different from its public host, for example inside Docker.
OPENCLOUD_HOST=cloud.example.com
OPENCLOUD_USER=ambrogio
OPENCLOUD_APP_TOKEN=
# Apache Tika, to read PDFs and office documents. Without it only text files are read.
TIKA_URL=http://opencloud-tika:9998
# Any long random string: MCP clients send it as Authorization: Bearer.
MCP_TOKEN=
HTTP_PORT=3000
