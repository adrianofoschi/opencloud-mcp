#!/bin/sh
# Blocks commits that add secrets. Enable once per clone with:
#   git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not on PATH. Install gitleaks 8.30.1 to commit in this repository." >&2
  exit 1
fi
exec gitleaks git --pre-commit --staged --redact --no-banner .
